#!/usr/bin/env bash
#
# git-wt — manage git worktrees under a single central root.
#
# Git treats any executable named git-<name> on PATH as a subcommand, so this
# file is invoked as `git wt`.
#
# Worktrees live at $GIT_WORKTREES_ROOT/<repo>/<branch>, outside every
# repository. Nothing rooted at a repository can see them, so no repository
# needs a .gitignore entry, and no tool needs an exclude rule.
#
#   git wt new <branch> [start-point]   create a worktree and enter-ready copy
#   git wt list                         list this repository's worktrees
#   git wt path <branch>                print a worktree's path
#   git wt rm <branch>                  remove a worktree, if it is clean
#   git wt clean                        remove worktrees whose branch is merged
#   git wt prune                        forget worktrees whose directory is gone

set -euo pipefail

ROOT="${GIT_WORKTREES_ROOT:-$HOME/Code/git-worktrees}"

die() { printf 'git wt: %s\n' "$*" >&2; exit 1; }
note() { printf '\033[2m%s\033[0m\n' "$*" >&2; }
warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }

require_repo() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
}

# The main worktree, even when this runs from inside a linked worktree.
main_tree() {
  git worktree list --porcelain | awk '/^worktree /{print substr($0,10); exit}'
}

repo_name() { basename "$(main_tree)"; }

# A branch name may hold a slash. Keep it out of the directory name so a
# worktree is always exactly one level below the repository directory.
slug() { printf '%s' "${1//\//-}"; }

to_clipboard() {
  command -v pbcopy >/dev/null 2>&1 || return 0
  printf '%s' "$1" | pbcopy 2>/dev/null && note "path copied to the clipboard"
}

wt_path() { printf '%s/%s/%s' "$ROOT" "$(repo_name)" "$(slug "$1")"; }

default_start() {
  git rev-parse --verify --quiet origin/HEAD >/dev/null 2>&1 &&
    git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null && return 0
  for b in origin/main origin/master; do
    git rev-parse --verify --quiet "$b" >/dev/null 2>&1 && { printf '%s' "$b"; return 0; }
  done
  printf 'HEAD'
}

# Files git ignores hold local configuration a new worktree needs to run.
copy_local_env() {
  local from="$1" to="$2" f base
  for f in "$from"/.env.local "$from"/.env "$from"/.env.*.local; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    git -C "$from" check-ignore -q "$base" 2>/dev/null || continue
    cp "$f" "$to/$base"
    note "copied $base"
  done
}

is_clean() { [ -z "$(git -C "$1" status --porcelain 2>/dev/null)" ]; }

branch_of() {
  git worktree list --porcelain |
    awk -v p="$1" '$1=="worktree" && $2==p {f=1} f && $1=="branch" {print substr($2,12); exit}'
}

# A branch is finished when the merge landed, whichever way it landed. A
# squash or rebase merge leaves no ancestry, so ask the forge as well.
is_merged() {
  local branch="$1" base
  base=$(default_start)
  if git merge-base --is-ancestor "$branch" "$base" 2>/dev/null; then return 0; fi
  command -v gh >/dev/null 2>&1 || return 1
  [ "$(gh pr list --head "$branch" --state merged --json number -q 'length' 2>/dev/null || echo 0)" -gt 0 ]
}

cmd_new() {
  local install=1
  while [ $# -gt 0 ] && [ "${1:0:2}" = "--" ]; do
    case "$1" in
      --no-install) install=0; shift ;;
      *) die "unknown option $1" ;;
    esac
  done

  local branch="${1:-}" start="${2:-}"
  [ -n "$branch" ] || die "new needs a branch name"
  require_repo

  local main path
  main=$(main_tree)
  path=$(wt_path "$branch")
  [ -e "$path" ] && die "$path already exists"

  mkdir -p "$(dirname "$path")"

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add "$path" "$branch"
  elif git ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
    git fetch --quiet origin "$branch"
    git worktree add --track -b "$branch" "$path" "origin/$branch"
  else
    [ -n "$start" ] || start=$(default_start)
    git worktree add -b "$branch" "$path" "$start"
  fi

  copy_local_env "$main" "$path"

  if [ "$install" = 1 ] && [ -f "$path/pnpm-lock.yaml" ] && command -v pnpm >/dev/null 2>&1; then
    note "running pnpm install"
    (cd "$path" && pnpm install --silent) || warn "pnpm install failed; run it by hand"
  fi

  to_clipboard "$path"
  printf '%s\n' "$path"
}

cmd_list() {
  require_repo
  git worktree list
}

cmd_path() {
  [ -n "${1:-}" ] || die "path needs a branch name"
  require_repo
  local path
  path="$(wt_path "$1")"
  to_clipboard "$path"
  printf '%s\n' "$path"
}

remove_one() {
  local path="$1" branch="$2"
  git worktree remove "$path"
  if [ -n "$branch" ] && git show-ref --verify --quiet "refs/heads/$branch"; then
    git branch -D "$branch" >/dev/null
  fi
  rmdir "$(dirname "$path")" 2>/dev/null || true
  printf 'removed %s\n' "$path"
}

cmd_rm() {
  [ -n "${1:-}" ] || die "rm needs a branch name"
  require_repo
  local path branch
  path=$(wt_path "$1")
  [ -d "$path" ] || die "no worktree at $path"
  is_clean "$path" || die "$path has uncommitted changes"
  branch=$(branch_of "$path")
  remove_one "$path" "$branch"
}

cmd_clean() {
  require_repo
  local main path branch found=0
  main=$(main_tree)

  while IFS= read -r path; do
    [ "$path" = "$main" ] && continue
    case "$path" in "$ROOT"/*) ;; *) continue ;; esac

    branch=$(branch_of "$path")
    [ -n "$branch" ] || { warn "skipped $path — detached HEAD"; continue; }

    if ! is_clean "$path"; then
      warn "skipped $branch — uncommitted changes"
      continue
    fi
    if ! is_merged "$branch"; then
      note "kept $branch — not merged"
      continue
    fi
    remove_one "$path" "$branch"
    found=1
  done < <(git worktree list --porcelain | awk '/^worktree /{print substr($0,10)}')

  [ "$found" = 1 ] || note "nothing to clean"
}

cmd_prune() {
  require_repo
  git worktree prune -v
  local repo_dir
  repo_dir="$ROOT/$(repo_name)"
  [ -d "$repo_dir" ] && rmdir "$repo_dir" 2>/dev/null || true
}

usage() {
  sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  new)   shift; cmd_new "$@" ;;
  list|ls) shift; cmd_list "$@" ;;
  path)  shift; cmd_path "$@" ;;
  rm|remove) shift; cmd_rm "$@" ;;
  clean) shift; cmd_clean "$@" ;;
  prune) shift; cmd_prune "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command '$1'. Run git wt --help" ;;
esac
