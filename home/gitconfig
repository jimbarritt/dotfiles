	email = jim.barritt@gmail.com
  signingkey = 42A0F567

[init]
  defaultBranch = main

[color]
	diff = auto
	status = auto
	branch = auto
	interactive = auto

[alias]
  com = commit 
  psh = push
  sm = submodule
	st = status
	br = branch
  serve = !git daemon --reuseaddr --verbose  --base-path=. --export-all ./.git
  lol = !git log --reverse --perl-regexp --author='^(?!.*(\\[bot\\]|dependabot|renovate|github-actions|semantic-release)).*$' --format='%C(yellow) %h %Creset %<(12,trunc)%an %cd %s' --date=format:'%y-%m-%d %H:%M' -15
        
[push]
	default = matching

[core]
	pager = delta
	autocrlf = input
	attributesFile = ~/.gitattributes

[diff "nocontext"]
	xfuncname = "$^"

[delta]
  # Appearance
  navigate = true    # Use n/N to navigate between diff sections
  light = false      # Dark mode; presentation-mode overrides via ~/.gitconfig-presentation
  side-by-side = false  # Set to true if you prefer side-by-side diffs
  line-numbers = true
    
  hunk-header-style = syntax

  syntax-theme = Monokai Extended
  
  # Minimal visual noise
  minus-style = "syntax #51161a"
  minus-emph-style = "syntax #8f2027"
  plus-style = "syntax #17552a"
  plus-emph-style = "syntax #1f7034"

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	required = true

[credential]
	helper = !aws codecommit credential-helper $@
	UseHttpPath = true

[pager]
  branch = false
	log = false

[advice]
      statusHints = false
      detachedHead = false
      pushUpdateRejected = false
      pushNonFFCurrent   = false

# Light-mode delta overrides, written by bin/presentation-mode
[include]
    path = ~/.gitconfig-presentation

# Include work config if it exists (checked last, so it overrides)
[include]
    path = ~/.gitconfig-work
